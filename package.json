{
  "name": "kdanni-map",
  "version": "0.1.0",
  "private": true,
  "description": "OpenStreetMap desktop viewer with KML/KMZ layers",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "hu.kdanni.map",
    "productName": "Kdanni Map",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@tmcw/togeojson": "^7.1.3",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.4"
  }
}
